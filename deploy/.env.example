# 複製成 ~/gts-web/.env（VM 上），填入實際值
# Harbor（沿用 boss-timing 那組）
REMOTE_REGISTRY_IP=harbor.example.com

# ⚠️ 以下三個 tag 記的是「打算跑的」，不是「實際在跑的」。
#    deploy.sh 必須先寫這裡，docker compose 才解析得出要拉哪顆 image，所以部署
#    只要在那之後失敗（pull 失敗／healthcheck 逾時），這裡就會留下一個從沒跑起
#    來的 tag。要判斷線上版本一律用：
#        docker inspect gts_web_store_blue --format '{{.Config.Image}}'
#    詳見 README「.env 的定位」一節。

# 藍綠雙 slot 要拉的 image tag（初次設定填 latest，之後由 deploy.sh 自動維護）
BLUE_TAG=latest
GREEN_TAG=latest

# 目前對外流量的 tag（deploy.sh / rollback.sh 維護，僅供人看/追蹤，非真相來源）
ACTIVE_TAG=latest
